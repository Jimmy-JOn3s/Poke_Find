# Copy to backend/.env for local development. Real environment variables override this file.
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Secret key mixed into every password hash (at least 32 characters). Generate it like the secret key.
# Keep it outside the database and never change it: changing or losing it forces every user to reset.
DJANGO_PASSWORD_PEPPER=
# 1 = local development (SQLite allowed, no HTTPS enforcement). Leave unset in production.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the web app; password-reset emails link here (https:// in production).
FRONTEND_URL=http://localhost:5173
USD_TO_THB_RATE=35.00
# Password that `manage.py seed_demo` gives every demo account (development only).
DEMO_SEED_PASSWORD=

# --- Production -------------------------------------------------------------
# PostgreSQL is required whenever DJANGO_DEBUG is not 1.
# POSTGRES_DB=pokefind
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# Set to 1 only when your proxy/load balancer terminates TLS and sets X-Forwarded-Proto,
# otherwise DJANGO_SECURE_SSL_REDIRECT causes a redirect loop.
# DJANGO_BEHIND_TLS_PROXY=0
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# How many proxies sit in front of Django and append to X-Forwarded-For (0 = none).
# DJANGO_NUM_PROXIES=0
# Shared cache for rate limits when running more than one worker process.
# REDIS_URL=redis://localhost:6379/0
# Email (required in production: set RESEND_API_KEY or SMTP below; with DJANGO_DEBUG=1 and neither set, emails print to the console).
# Resend (recommended): https://resend.com — use a verified domain in DEFAULT_FROM_EMAIL.
# Without a verified domain, Resend only delivers to the email on your Resend account (test mode).
# RESEND_API_KEY=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# DEFAULT_FROM_EMAIL=PokeFind <no-reply@your-domain>
# PASSWORD_RESET_TIMEOUT_MINUTES=60
# MAGIC_LINK_TIMEOUT_MINUTES=15
# THROTTLE_MAGIC_LINK_RATE=10/hour
# THROTTLE_PASSWORD_RESET_RATE=10/hour
# Optional tuning (defaults shown).
# THROTTLE_ANON_RATE=120/min
# THROTTLE_USER_RATE=600/min
# THROTTLE_AUTH_RATE=10/min
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# Largest avatar/listing photo accepted, in MB (also cap request size in your proxy).
# MAX_UPLOAD_MB=5
