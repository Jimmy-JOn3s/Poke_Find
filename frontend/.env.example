# Copy to frontend/.env.development.local for `vite dev`.
# Builds (deploy and deploy-preview) must get VITE_API_URL from the shell or the Figma Make
# environment, and refuse to build with a localhost URL.

# Base URL of the Django API, including /api. Required; there is no default.
VITE_API_URL=http://localhost:8000/api
# Optional, local dev server only (never bundled): fills the password in the hidden demo picker.
# Use the same value as DEMO_SEED_PASSWORD in backend/.env.
DEMO_PASSWORD=
